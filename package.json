{
  "name": "oore-build",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "update:latest": "bun update --latest --recursive"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tailwindcss": "^1.10.2",
    "oxlint-tsgolint": "7.0.2001",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "tinypool": "2.2.0",
    "vite": "8.2.4"
  },
  "packageManager": "bun@1.4.0"
}
