{
  "platforms": [
    "android",
    "ios"
  ],
  "steps": [
    {
      "name": "pre_build-1",
      "phase": "pre_build",
      "run": "flutter pub get",
      "source": "default"
    },
    {
      "name": "build-1",
      "phase": "build",
      "run": "flutter build apk --release",
      "source": "default",
      "platform": "android"
    },
    {
      "name": "build-2",
      "phase": "build",
      "run": "flutter build ios --release --no-codesign",
      "source": "default",
      "platform": "ios"
    }
  ],
  "env": [],
  "artifact_patterns": [
    "build/app/outputs/flutter-apk/*.apk",
    "build/app/outputs/bundle/**/*.aab",
    "build/ios/ipa/*.ipa"
  ],
  "build_number_offset": 0,
  "runs_on": [],
  "isolation": "host"
}
