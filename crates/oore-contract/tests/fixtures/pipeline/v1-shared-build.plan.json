{
  "platforms": [
    "android"
  ],
  "steps": [
    {
      "name": "pre_build-1",
      "phase": "pre_build",
      "run": "dart run build_runner build",
      "source": "commands.pre_build[0]"
    },
    {
      "name": "build-1",
      "phase": "build",
      "run": "flutter build appbundle --release",
      "source": "commands.build[0]"
    },
    {
      "name": "build-2",
      "phase": "build",
      "run": "flutter build apk --release",
      "source": "commands.build[1]"
    },
    {
      "name": "post_build-1",
      "phase": "post_build",
      "run": "echo done",
      "source": "commands.post_build[0]"
    }
  ],
  "env": [],
  "artifact_patterns": [
    "build/app/outputs/flutter-apk/*.apk",
    "build/app/outputs/bundle/**/*.aab"
  ],
  "build_number_offset": 0,
  "runs_on": [],
  "isolation": "host"
}
