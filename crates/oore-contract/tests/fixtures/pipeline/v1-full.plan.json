{
  "platforms": [
    "android",
    "ios"
  ],
  "flutter_version": "3.24.5",
  "steps": [
    {
      "name": "pre_build-1",
      "phase": "pre_build",
      "run": "flutter pub get",
      "source": "commands.pre_build[0]"
    },
    {
      "name": "pre_build-2",
      "phase": "pre_build",
      "run": "flutter pub get",
      "source": "commands.pre_build[1]"
    },
    {
      "name": "build-1",
      "phase": "build",
      "run": "flutter build apk --release --split-per-abi --build-number=$OORE_VERSION_CODE",
      "source": "commands.build[0]",
      "platform": "android"
    },
    {
      "name": "build-2",
      "phase": "build",
      "run": "flutter build ios --release --no-codesign",
      "source": "commands.build[1]",
      "platform": "ios"
    },
    {
      "name": "post_build-1",
      "phase": "post_build",
      "run": "echo \"Build complete\"",
      "source": "commands.post_build[0]"
    }
  ],
  "env": [
    {
      "key": "BUILD_FLAVOR",
      "value": "staging"
    },
    {
      "key": "SENTRY_DSN",
      "value": "${{ secrets.SENTRY_DSN }}"
    }
  ],
  "artifact_patterns": [
    "build/app/outputs/flutter-apk/*.apk",
    "build/ios/ipa/*.ipa"
  ],
  "build_number_offset": 4000,
  "runs_on": [
    "macos",
    "xcode-16"
  ],
  "isolation": "vm"
}
