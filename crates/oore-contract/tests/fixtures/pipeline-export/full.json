{
  "execution_config": {
    "platforms": ["android", "ios"],
    "flutter_version": "3.24.5",
    "commands": {
      "pre_build": ["dart run build_runner build --delete-conflicting-outputs"],
      "build": ["./scripts/upload-symbols.sh"],
      "post_build": ["flutter test", "echo \"done\""]
    },
    "platform_build_args": { "android": ["--split-per-abi", "--obfuscate", "--split-debug-info=build/symbols"], "ios": [], "macos": [] },
    "platform_commands": { "ios": "flutter build ipa --release --export-options-plist=ios/ExportOptions.plist" },
    "env": [
      { "key": "API_URL", "value": "https://staging.example.com" },
      { "key": "SENTRY_DSN", "value": "${{ secrets.SENTRY_DSN }}" },
      { "key": "VERBOSE", "value": "yes" }
    ],
    "artifact_patterns": ["build/app/outputs/flutter-apk/*.apk", "build/app/outputs/bundle/**/*.aab", "build/ios/ipa/*.ipa"],
    "build_number_offset": 4000,
    "runs_on": ["Xcode-16", "arm64"],
    "isolation": "vm"
  },
  "trigger_config": {
    "events": ["push", "tag_push"],
    "branches": ["main", "release/*"],
    "tags": ["v*"],
    "paths": ["lib/**", "pubspec.yaml"],
    "schedules": [{ "cron": "0 3 * * *" }]
  },
  "google_play": {
    "enabled": true,
    "service_account_secret": "PLAY_SERVICE_ACCOUNT_JSON",
    "package_name": "com.example.shop",
    "track": "production",
    "rollout_percent": 5,
    "draft": false
  },
  "app_store": {
    "enabled": true,
    "destination": "testflight",
    "testflight_groups": ["QA"]
  }
}
